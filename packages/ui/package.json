{
  "name": "@lmthing/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./catalog": {
      "source": "./src/entry/catalog.ts",
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./kit": {
      "source": "./src/entry/kit.ts",
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    }
  },
  "scripts": {
    "build": "pnpm build:catalog && tsx scripts/build-kit.ts",
    "build:entries": "tsx scripts/build-entries.ts",
    "kit:themes": "tsx scripts/build-themes.ts",
    "build:catalog": "pnpm build:entries && tsx scripts/bundle-check.ts && pnpm kit:themes",
    "catalog:bundle-check": "tsx scripts/bundle-check.ts",
    "typecheck": "tsx scripts/build-entries.ts && tsc -p tsconfig.json",
    "test": "tsx scripts/build-entries.ts && tsx scripts/check.ts",
    "llm:check": "pnpm build:catalog && tsx scripts/llm-check.ts",
    "shoot": "tsx scripts/build-entries.ts && tsx scripts/shoot.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@tamagui/core": "1.144.4",
    "@tamagui/lucide-icons": "1.144.4",
    "react": "19.3.1",
    "react-native-web": "0.21.4",
    "react-native-svg": "15.15.3",
    "tamagui": "1.144.4"
  },
  "devDependencies": {
    "@tamagui/core": "1.144.4",
    "@tamagui/lucide-icons": "1.144.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native-web": "0.21.4",
    "react-native-svg": "15.15.3",
    "tamagui": "1.144.4"
  }
}

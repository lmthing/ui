{
  "name": "lmthing-ui-workspace",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build:entries": "pnpm --filter @lmthing/ui build:entries",
    "kit:themes": "pnpm --filter @lmthing/ui kit:themes",
    "build:catalog": "pnpm --filter @lmthing/ui build:catalog",
    "catalog:bundle-check": "pnpm --filter @lmthing/ui catalog:bundle-check",
    "gallery": "pnpm build:catalog && pnpm --filter @lmthing/gallery dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-native-web": "0.19.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "vite": "8.3.8"
  }
}
